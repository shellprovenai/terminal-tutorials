# polecenia.log — Search a whole project with grep -r, without node_modules, .git or binary junk
# obraz: docker.io/library/debian:13 (sha256:bfc36aecdece0387418759dba474aa856c026ca8087da3606b41b90ab0509c99), Debian 13.7, uruchomiono 2026-11-21T18:58:53Z
# wersje: grep (GNU grep) 3.11
# pakiety doinstalowane z repozytorium Debiana: (brak)
# katalog roboczy: /lab/app; każdy rozdział = osobna powłoka (bash --norc), jak w nagraniu
# '%' = przygotowanie (w filmie ukryte), '$' = polecenie pokazane w filmie

## [02] The noisy first search
% mkdir -p src node_modules/left-pad .git dist bin logs
[exit 0 — OK]

% printf 'def login(user):\n    # TODO: rate limit\n    return check(user)\n' > src/auth.py
[exit 0 — OK]

% printf 'import auth\n# todo: remove debug flag\nDEBUG = True\nVERSION = "1.5"\n' > src/main.py
[exit 0 — OK]

% printf '// TODO: handle errors\nfetch("/api/catalog")\n' > src/client.js
[exit 0 — OK]

% printf '// TODO upstream bug\nmodule.exports = 1\n' > node_modules/left-pad/index.js
[exit 0 — OK]

% printf '[core]\n\t# TODO nothing\n' > .git/config
[exit 0 — OK]

% printf 'function a(){/*TODO*/return 1}' > dist/app.min.js
[exit 0 — OK]

% printf '\000\001ELF TODO\000' > bin/tool
[exit 0 — OK]

% printf '2026 login ok\n2026 user log out\nversion 105 started\n' > logs/app.log
[exit 0 — OK]

$ grep -r "TODO" .
./src/client.js:// TODO: handle errors
./src/auth.py:    # TODO: rate limit
./.git/config:	# TODO nothing
./node_modules/left-pad/index.js:// TODO upstream bug
./dist/app.min.js:function a(){/*TODO*/return 1}
grep: ./bin/tool: binary file matches
[exit 0 — OK]

# czas rozdziału: 1.9 s

## [03] Skip folders with --exclude-dir
$ grep -rn "TODO" --exclude-dir=node_modules --exclude-dir=.git .
./src/client.js:1:// TODO: handle errors
./src/auth.py:2:    # TODO: rate limit
./dist/app.min.js:1:function a(){/*TODO*/return 1}
grep: ./bin/tool: binary file matches
[exit 0 — OK]

# czas rozdziału: 1.5 s

## [04] Ignore binary files with -I
$ grep -rnI "TODO" --exclude-dir={node_modules,.git,dist} .
./src/client.js:1:// TODO: handle errors
./src/auth.py:2:    # TODO: rate limit
[exit 0 — OK]

# czas rozdziału: 1.7 s

## [05] Case, file types and file names
$ grep -rniI "todo" --exclude-dir={node_modules,.git,dist} .
./src/main.py:2:# todo: remove debug flag
./src/client.js:1:// TODO: handle errors
./src/auth.py:2:    # TODO: rate limit
[exit 0 — OK]

$ grep -rl "TODO" --include="*.py" .
./src/auth.py
[exit 0 — OK]

# czas rozdziału: 1.6 s

## [06] Whole words with -w
$ grep -rn "log" logs src
logs/app.log:1:2026 login ok
logs/app.log:2:2026 user log out
src/client.js:2:fetch("/api/catalog")
src/auth.py:1:def login(user):
[exit 0 — OK]

$ grep -rnw "log" logs src
logs/app.log:2:2026 user log out
[exit 0 — OK]

# czas rozdziału: 1.6 s

## [07] Dots are wildcards: use -F
$ grep -rn "1.5" src logs
src/main.py:4:VERSION = "1.5"
logs/app.log:3:version 105 started
[exit 0 — OK]

$ grep -rnF "1.5" src logs
src/main.py:4:VERSION = "1.5"
[exit 0 — OK]

# czas rozdziału: 1.9 s

## [08] Several patterns and some context
$ grep -rnIE "TODO|FIXME|DEBUG" --exclude-dir={node_modules,.git,dist} .
./src/main.py:3:DEBUG = True
./src/client.js:1:// TODO: handle errors
./src/auth.py:2:    # TODO: rate limit
[exit 0 — OK]

$ grep -n -A 1 "TODO" src/auth.py
2:    # TODO: rate limit
3-    return check(user)
[exit 0 — OK]

