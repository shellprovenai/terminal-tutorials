## [03] set -u and ${VAR:?}: no silent empty variables
$ unset BUILD_DIR; echo rm -rf "$BUILD_DIR/"
rm -rf /
[exit 0 — OK]

$ bash -c 'set -u; echo rm -rf "$BUILD_DIR/"'
