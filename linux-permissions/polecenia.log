## [02] Reading ls -l
% useradd -m alice && useradd -m bob && groupadd web && usermod -aG web alice
[exit 0 — OK]

% echo hello > index.html && printf '#!/bin/sh\necho deployed\n' > deploy.sh && echo DB_PASSWORD=demo > secret.env
[exit 0 — OK]

% mkdir private && echo x > private/notes.txt && chown -R alice:web /lab/site
[exit 0 — OK]

$ ls -l
total 16
-rw-r--r-- 1 alice web   24 Nov 21 15:37 deploy.sh
-rw-r--r-- 1 alice web    6 Nov 21 15:37 index.html
drwxr-xr-x 2 alice web 4096 Nov 21 15:37 private
-rw-r--r-- 1 alice web   17 Nov 21 15:37 secret.env
[exit 0 — OK]

# czas rozdziału: 5.5 s

## [03] From letters to numbers
$ stat -c '%A %a %U:%G %n' *
-rw-r--r-- 644 alice:web deploy.sh
-rw-r--r-- 644 alice:web index.html
drwxr-xr-x 755 alice:web private
-rw-r--r-- 644 alice:web secret.env
[exit 0 — OK]

