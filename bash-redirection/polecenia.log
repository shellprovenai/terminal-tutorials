# polecenia.log — Bash redirection explained: >, >>, 2>, 2>&1 and | (and why the order matters)
# obraz: docker.io/library/debian:13 (sha256:bfc36aecdece0387418759dba474aa856c026ca8087da3606b41b90ab0509c99), Debian 13.7, uruchomiono 2026-11-21T19:31:31Z
# wersje: GNU bash, version 5.2.37(1)-release (x86_64-pc-linux-gnu)
# pakiety doinstalowane z repozytorium Debiana: (brak)
# katalog roboczy: /lab/io; każdy rozdział = osobna powłoka (bash --norc), jak w nagraniu
# '%' = przygotowanie (w filmie ukryte), '$' = polecenie pokazane w filmie

## [02] Two output streams
% mkdir logs && echo ok > logs/a.log
[exit 0 — OK]

$ ls logs missing
ls: cannot access 'missing': No such file or directory
logs:
a.log
[exit 2 — OK (oczekiwany ≠0)]

# czas rozdziału: 1.8 s

## [03] > sends stdout to a file
$ ls logs missing > out.txt
ls: cannot access 'missing': No such file or directory
[exit 2 — OK (oczekiwany ≠0)]

$ cat out.txt
logs:
a.log
[exit 0 — OK]

# czas rozdziału: 2.2 s

## [04] 2> sends stderr to a file
$ ls logs missing 2> err.txt
logs:
a.log
[exit 2 — OK (oczekiwany ≠0)]

$ cat err.txt
ls: cannot access 'missing': No such file or directory
[exit 0 — OK]

$ ls logs missing 2>/dev/null
logs:
a.log
[exit 2 — OK (oczekiwany ≠0)]

# czas rozdziału: 1.9 s

## [05] 2>&1: both streams into one file
$ ls logs missing > all.txt 2>&1
[exit 2 — OK (oczekiwany ≠0)]

$ cat all.txt
ls: cannot access 'missing': No such file or directory
logs:
a.log
[exit 0 — OK]

$ ls logs missing 2>&1 > wrong.txt
ls: cannot access 'missing': No such file or directory
[exit 2 — OK (oczekiwany ≠0)]

$ cat wrong.txt
logs:
a.log
[exit 0 — OK]

# czas rozdziału: 1.8 s

## [06] > overwrites, >> appends
$ echo first > notes.txt && echo second > notes.txt && cat notes.txt
second
[exit 0 — OK]

$ echo third >> notes.txt && cat notes.txt
second
third
[exit 0 — OK]

$ set -o noclobber && echo oops > notes.txt
/tmp/.sp_seg.sh: line 8: notes.txt: cannot overwrite existing file
[exit 1 — OK (oczekiwany ≠0)]

$ set +o noclobber
[exit 0 — OK]

# czas rozdziału: 1.7 s

## [07] Pipes only carry stdout
$ ls logs missing | wc -l
ls: cannot access 'missing': No such file or directory
2
[exit 0 — OK]

$ ls logs missing 2>&1 | wc -l
3
[exit 0 — OK]

# czas rozdziału: 1.7 s

## [08] tee: save it and see it
$ ls logs missing 2>&1 | tee run.log
ls: cannot access 'missing': No such file or directory
logs:
a.log
[exit 0 — OK]

$ cat run.log
ls: cannot access 'missing': No such file or directory
logs:
a.log
[exit 0 — OK]

# czas rozdziału: 1.9 s

## [09] Quick check
$ ls logs missing > quiz.txt 2>&1
[exit 2 — OK (oczekiwany ≠0)]

$ cat quiz.txt
ls: cannot access 'missing': No such file or directory
logs:
a.log
[exit 0 — OK]

$ echo a > quiz2.txt && echo b >> quiz2.txt && cat quiz2.txt
a
b
[exit 0 — OK]

# czas rozdziału: 1.9 s

