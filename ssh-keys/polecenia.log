## [02] 1. Generate a key
% useradd -m -s /bin/bash deploy && mkdir -p /run/sshd && /usr/sbin/sshd
[exit 0 — OK]

$ ssh-keygen -t ed25519 -C "laptop" -f ~/.ssh/id_ed25519 -N ""
