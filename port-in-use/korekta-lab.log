### B: a server that reads its port from a config file: ps has no idea
$ echo 9002 > /tmp/app.port; cat > /tmp/app <<'X'
#!/bin/sh
exec perl -MIO::Socket::INET -e '$p=<STDIN>; chomp $p; $s=IO::Socket::INET->new(LocalPort=>$p,Listen=>5,ReuseAddr=>1) or die; sleep 300' < /tmp/app.port
X
chmod +x /tmp/app; (setsid /tmp/app >/dev/null 2>&1 &); sleep 1
[exit 0]

