## [02] The startup files
% useradd -m -s /bin/bash demo
[exit 0 — OK]

% sed -i '1i echo "-> reading ~/.bashrc"' /home/demo/.bashrc && sed -i '1i echo "-> reading ~/.profile"' /home/demo/.profile
[exit 0 — OK]

% echo "alias deploy='echo deploying the app'" >> /home/demo/.bashrc
[exit 0 — OK]

$ ls -A /home/demo
.bash_logout
.bashrc
.profile
[exit 0 — OK]

$ tail -n 1 /home/demo/.bashrc
alias deploy='echo deploying the app'
[exit 0 — OK]

