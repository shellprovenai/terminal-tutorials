# solution.md
$ printf '%s\n' 'PATH=/work/bin:/usr/bin:/bin' '30 2 * * * cd /work/jobs && ./dump.sh >> /work/logs/dump.log 2>&1' > /work/dump.cron && crontab /work/dump.cron

[exit 0]

