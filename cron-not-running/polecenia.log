# polecenia.log — Cron job not running? It works in the terminal, here's why it fails in cron
# obraz: localhost/shellproven-cron-debug:13 (sha256:471af4740a3d26642e294e1c05fc05d2f8bb3051c1809d17a4ec6a25108c5f5e), Debian 13.7, uruchomiono 2026-11-21T20:06:15Z
# wersje: cron 3.0pl1-197
# pakiety doinstalowane z repozytorium Debiana: cron
# katalog roboczy: /lab/jobs; każdy rozdział = osobna powłoka (bash --norc), jak w nagraniu
# '%' = przygotowanie (w filmie ukryte), '$' = polecenie pokazane w filmie

## [02] A script that works
% printf '#!/bin/sh\necho "report for $(hostname): 42 orders"\n' > /usr/local/bin/report-tool && chmod +x /usr/local/bin/report-tool
[exit 0 — OK]

% printf '#!/bin/sh\nreport-tool > report.txt\necho "saved report"\n' > backup.sh && chmod +x backup.sh && cron
[exit 0 — OK]

$ cat backup.sh
#!/bin/sh
report-tool > report.txt
echo "saved report"
[exit 0 — OK]

$ ./backup.sh && cat report.txt
saved report
report for demo: 42 orders
[exit 0 — OK]

# czas rozdziału: 1.5 s

## [03] Schedule it, and log the output
% printf '# min hour day month weekday  command\n* * * * * /lab/jobs/backup.sh >> /tmp/backup.log 2>&1\n* * * * * env > /tmp/cron-env.txt\n' > first.cron
[exit 0 — OK]

$ cat first.cron
# min hour day month weekday  command
* * * * * /lab/jobs/backup.sh >> /tmp/backup.log 2>&1
* * * * * env > /tmp/cron-env.txt
[exit 0 — OK]

$ crontab first.cron && crontab -l
# min hour day month weekday  command
* * * * * /lab/jobs/backup.sh >> /tmp/backup.log 2>&1
* * * * * env > /tmp/cron-env.txt
[exit 0 — OK]

# czas rozdziału: 1.7 s

## [04] Why it fails
% for i in $(seq 90); do [ -s /tmp/cron-env.txt ] && break; sleep 2; done; sleep 2
[exit 0 — OK]

$ cat /tmp/backup.log
/lab/jobs/backup.sh: 2: report-tool: not found
saved report
[exit 0 — OK]

$ cat /tmp/cron-env.txt
HOME=/root
LOGNAME=root
PATH=/usr/bin:/bin
SHELL=/bin/sh
PWD=/root
[exit 0 — OK]

$ ls /root
report.txt
[exit 0 — OK]

# czas rozdziału: 45.4 s

## [05] The fix: PATH and cd in the crontab
% printf 'PATH=/usr/local/bin:/usr/bin:/bin\n# min hour day month weekday  command\n* * * * * cd /lab/jobs && ./backup.sh >> /tmp/backup.log 2>&1\n* * * * * echo "ran at $(date +%%H:%%M)" >> /tmp/broken.log\n* * * * * echo "ran at $(date +\\%%H:\\%%M)" >> /tmp/fixed.log\n' > fixed.cron
[exit 0 — OK]

$ cat fixed.cron
PATH=/usr/local/bin:/usr/bin:/bin
# min hour day month weekday  command
* * * * * cd /lab/jobs && ./backup.sh >> /tmp/backup.log 2>&1
* * * * * echo "ran at $(date +%H:%M)" >> /tmp/broken.log
* * * * * echo "ran at $(date +\%H:\%M)" >> /tmp/fixed.log
[exit 0 — OK]

$ crontab fixed.cron
[exit 0 — OK]

# czas rozdziału: 1.6 s

## [06] Check it
% for i in $(seq 90); do [ -s /tmp/fixed.log ] && break; sleep 2; done; sleep 2
[exit 0 — OK]

$ tail -n 1 /tmp/backup.log && cat report.txt
saved report
report for demo: 42 orders
[exit 0 — OK]

# czas rozdziału: 59.2 s

