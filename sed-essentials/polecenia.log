# polecenia.log — sed for the three things you actually need: replace in place, delete lines, print a range
# obraz: docker.io/library/debian:13 (sha256:bfc36aecdece0387418759dba474aa856c026ca8087da3606b41b90ab0509c99), Debian 13.7, uruchomiono 2026-11-21T22:22:34Z
# wersje: sed (GNU sed) 4.9
# pakiety doinstalowane z repozytorium Debiana: (brak)
# katalog roboczy: /lab/sed; każdy rozdział = osobna powłoka (bash --norc), jak w nagraniu
# '%' = przygotowanie (w filmie ukryte), '$' = polecenie pokazane w filmie

## [02] Replace: s/old/new/
% printf '# app settings\nhost=localhost\nport=8080\nadmin_port=8080\n\n# links\nurl=http://localhost:8080/health?port=8080#start\ndebug=true\n' > app.conf
[exit 0 — OK]

% for i in $(seq 1 30); do echo "2026-11-20 10:00:$i INFO request $i"; done > app.log && sed -i '12s/INFO/ERROR/; 21s/INFO/ERROR/' app.log
[exit 0 — OK]

% sed -i '15i --- START deploy' app.log && sed -i '18i --- END deploy' app.log
[exit 0 — OK]

$ cat app.conf
# app settings
host=localhost
port=8080
admin_port=8080

# links
url=http://localhost:8080/health?port=8080#start
debug=true
[exit 0 — OK]

$ sed 's/8080/9090/' app.conf
# app settings
host=localhost
port=9090
admin_port=9090

# links
url=http://localhost:9090/health?port=8080#start
debug=true
[exit 0 — OK]

$ sed 's/8080/9090/g' app.conf | grep 9090
port=9090
admin_port=9090
url=http://localhost:9090/health?port=9090#start
[exit 0 — OK]

$ grep 8080 app.conf
port=8080
admin_port=8080
url=http://localhost:8080/health?port=8080#start
[exit 0 — OK]

# czas rozdziału: 2.4 s

## [03] Edit in place, with a backup
$ sed -i.bak 's/^port=8080/port=9090/' app.conf
[exit 0 — OK]

$ diff app.conf.bak app.conf
3c3
< port=8080
---
> port=9090
[exit 1 — OK (oczekiwany ≠0)]

# czas rozdziału: 1.3 s

## [04] The trap: -i without a backup
$ sed -i '/#/d' app.conf && cat app.conf
host=localhost
port=9090
admin_port=8080

debug=true
[exit 0 — OK]

$ cp app.conf.bak app.conf && sed -i 's/^port=8080/port=9090/' app.conf
[exit 0 — OK]

$ sed '/^#/d' app.conf
host=localhost
port=9090
admin_port=8080

url=http://localhost:8080/health?port=8080#start
debug=true
[exit 0 — OK]

# czas rozdziału: 1.4 s

## [05] Delete lines
$ sed '/^#/d; /^$/d' app.conf
host=localhost
port=9090
admin_port=8080
url=http://localhost:8080/health?port=8080#start
debug=true
[exit 0 — OK]

$ sed '2d; $d' app.conf
# app settings
port=9090
admin_port=8080

# links
url=http://localhost:8080/health?port=8080#start
[exit 0 — OK]

# czas rozdziału: 1.2 s

## [06] Print a range
$ sed -n '10,15p' app.log
2026-11-20 10:00:10 INFO request 10
2026-11-20 10:00:11 INFO request 11
2026-11-20 10:00:12 ERROR request 12
2026-11-20 10:00:13 INFO request 13
2026-11-20 10:00:14 INFO request 14
--- START deploy
[exit 0 — OK]

$ sed -n '/ERROR/p' app.log
2026-11-20 10:00:12 ERROR request 12
2026-11-20 10:00:21 ERROR request 21
[exit 0 — OK]

$ sed -n '/START/,/END/p' app.log
--- START deploy
2026-11-20 10:00:15 INFO request 15
2026-11-20 10:00:16 INFO request 16
--- END deploy
[exit 0 — OK]

$ echo "root=/var/www/html" | sed 's|/var/www|/srv/www|'
root=/srv/www/html
[exit 0 — OK]

# czas rozdziału: 1.3 s

