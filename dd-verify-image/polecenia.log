# polecenia.log — Write a USB image with dd and verify it: checksums, pv, and the "wrong device" danger
# obraz: localhost/shellproven-dd-verify-image:13 (sha256:df655399ee8a094939142c64d0b0b254d29ee9cf0545f953d5f52eac43d95a43), Debian 13.7, uruchomiono 2026-11-22T02:14:15Z
# wersje: dd (coreutils) 9.7 | pv 1.9.31
# pakiety doinstalowane z repozytorium Debiana: pv
# katalog roboczy: /lab/usb; każdy rozdział = osobna powłoka (bash --norc), jak w nagraniu
# '%' = przygotowanie (w filmie ukryte), '$' = polecenie pokazane w filmie

## [02] Verify the download
% head -c 48M /dev/urandom > distro.iso && sha256sum distro.iso > SHA256SUMS
[exit 0 — OK]

$ ls -lh distro.iso && cat SHA256SUMS
-rw-r--r-- 1 root root 48M Nov 22 02:14 distro.iso
c16e1e91e014f55f87a0258ce37ff668c56ad1dcc553809df1f35ef6f27db15d  distro.iso
[exit 0 — OK]

$ sha256sum -c SHA256SUMS
distro.iso: OK
[exit 0 — OK]

# czas rozdziału: 1.8 s

## [03] Find the right device
$ lsblk -o NAME,SIZE,TYPE
NAME     SIZE TYPE
vda       60G disk
|-vda1  59.9G part
|-vda14    3M part
`-vda15  124M part
[exit 0 — OK]

$ truncate -s 128M usb.img && ls -lh usb.img
-rw-r--r-- 1 root root 128M Nov 22 02:14 usb.img
[exit 0 — OK]

# czas rozdziału: 1.3 s

## [04] Write with dd
$ dd if=distro.iso of=usb.img bs=4M conv=fsync,notrunc status=progress
12+0 records in
12+0 records out
50331648 bytes (50 MB, 48 MiB) copied, 0.471656 s, 107 MB/s
[exit 0 — OK]

# czas rozdziału: 2.2 s

## [05] Progress with pv
$ pv distro.iso > copy.img && ls -lh copy.img
-rw-r--r-- 1 root root 48M Nov 22 02:14 copy.img
[exit 0 — OK]

# czas rozdziału: 1.2 s

## [06] Verify the written copy
$ sha256sum distro.iso usb.img
c16e1e91e014f55f87a0258ce37ff668c56ad1dcc553809df1f35ef6f27db15d  distro.iso
f6a708c46e79ac6a551d78f52dfe9feb4009f747e738b8d5436ff5f1f37c1003  usb.img
[exit 0 — OK]

$ head -c "$(stat -c %s distro.iso)" usb.img | sha256sum && cut -d ' ' -f1 SHA256SUMS
c16e1e91e014f55f87a0258ce37ff668c56ad1dcc553809df1f35ef6f27db15d  -
c16e1e91e014f55f87a0258ce37ff668c56ad1dcc553809df1f35ef6f27db15d
[exit 0 — OK]

$ cmp -n "$(stat -c %s distro.iso)" distro.iso usb.img && echo "identical"
identical
[exit 0 — OK]

# czas rozdziału: 1.7 s

## [07] Quick check
$ head -c "$(stat -c %s distro.iso)" usb.img | sha256sum
c16e1e91e014f55f87a0258ce37ff668c56ad1dcc553809df1f35ef6f27db15d  -
[exit 0 — OK]

$ lsblk -o NAME,SIZE,TYPE | head -2
NAME     SIZE TYPE
vda       60G disk
[exit 0 — OK]

# czas rozdziału: 1.1 s

# PODSUMOWANIE: 12 poleceń, błędów: 0
