$ cut -d ' ' -f1 access.log | uniq -c | wc -l
8
[exit 0 — OK]

$ cut -d ' ' -f1 access.log | sort | uniq -c | wc -l
3
[exit 0 — OK]

$ tr -s ' ' < aligned.txt | cut -d ' ' -f2
