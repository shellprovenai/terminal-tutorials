## [02] cut: pick a column
% printf '10.0.0.5 GET /index.html 200\n10.0.0.7 GET /login 200\n10.0.0.5 POST /login 302\n10.0.0.9 GET /admin 404\n10.0.0.7 GET /api 500\n10.0.0.5 GET /missing 404\n10.0.0.9 GET /login 200\n10.0.0.5 GET /index.html 200\n' > access.log
[exit 0 — OK]

% printf 'id,city,amount\n1,Leeds,12\n2,lisbon,9\n3,Graz,120\n4,Leeds,30\n5,Lisbon,15\n6,graz,8\n' > orders.csv
[exit 0 — OK]

$ cat access.log
10.0.0.5 GET /index.html 200
10.0.0.7 GET /login 200
10.0.0.5 POST /login 302
10.0.0.9 GET /admin 404
10.0.0.7 GET /api 500
10.0.0.5 GET /missing 404
10.0.0.9 GET /login 200
10.0.0.5 GET /index.html 200
[exit 0 — OK]

$ cut -d ' ' -f1 access.log | head -4
10.0.0.5
10.0.0.7
10.0.0.5
10.0.0.9
[exit 0 — OK]

$ cut -d, -f2 orders.csv
city
Leeds
lisbon
Graz
Leeds
Lisbon
graz
[exit 0 — OK]

# czas rozdziału: 2.0 s

## [03] Count values: sort | uniq -c
$ cut -d ' ' -f1 access.log | uniq -c
      1 10.0.0.5
      1 10.0.0.7
      1 10.0.0.5
      1 10.0.0.9
      1 10.0.0.7
      1 10.0.0.5
      1 10.0.0.9
      1 10.0.0.5
[exit 0 — OK]

$ cut -d ' ' -f1 access.log | sort | uniq -c
      4 10.0.0.5
      2 10.0.0.7
      2 10.0.0.9
[exit 0 — OK]

$ cut -d ' ' -f1 access.log | sort | uniq -c | sort -rn
      4 10.0.0.5
      2 10.0.0.9
      2 10.0.0.7
[exit 0 — OK]

$ cut -d ' ' -f4 access.log | sort | uniq -c | sort -rn
      4 200
      2 404
      1 500
      1 302
[exit 0 — OK]

# czas rozdziału: 3.1 s

## [04] tr: clean up before counting
$ tail -n +2 orders.csv | cut -d, -f2 | sort | uniq -c
      1 Graz
      2 Leeds
      1 Lisbon
      1 graz
      1 lisbon
[exit 0 — OK]

$ tail -n +2 orders.csv | cut -d, -f2 | tr 'A-Z' 'a-z' | sort | uniq -c | sort -rn
      2 lisbon
      2 leeds
      2 graz
[exit 0 — OK]

# czas rozdziału: 1.4 s

## [05] The trap: repeated spaces
$ printf 'alice    12  Leeds\nbob      7   Graz\n' > aligned.txt && cut -d ' ' -f2 aligned.txt
[exit 0 — OK]

$ tr -s ' ' < aligned.txt | cut -d ' ' -f2
12
7
[exit 0 — OK]

# czas rozdziału: 1.4 s

## [06] Sort numbers correctly
$ tail -n +2 orders.csv | sort -t, -k3
1,Leeds,12
3,Graz,120
5,Lisbon,15
4,Leeds,30
6,graz,8
2,lisbon,9
[exit 0 — OK]

$ tail -n +2 orders.csv | sort -t, -k3 -n
6,graz,8
2,lisbon,9
1,Leeds,12
5,Lisbon,15
4,Leeds,30
3,Graz,120
[exit 0 — OK]

# czas rozdziału: 1.3 s

