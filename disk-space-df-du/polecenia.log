# polecenia.log — Disk full? Find what's eating your space with df, du and sort (Linux)
# obraz: docker.io/library/debian:13 (sha256:bfc36aecdece0387418759dba474aa856c026ca8087da3606b41b90ab0509c99), Debian 13.7, uruchomiono 2026-11-21T19:39:43Z
# wersje: du (GNU coreutils) 9.7
# pakiety doinstalowane z repozytorium Debiana: (brak)
# katalog roboczy: /lab/srv; każdy rozdział = osobna powłoka (bash --norc), jak w nagraniu
# '%' = przygotowanie (w filmie ukryte), '$' = polecenie pokazane w filmie

## [02] Step 1: which filesystem is full? df -h
% mkdir -p app/logs app/cache/thumbs backups uploads
[exit 0 — OK]

% fallocate -l 60M app/logs/app.log.1 && fallocate -l 8M app/logs/app.log && fallocate -l 24M app/cache/thumbs/blob.bin
[exit 0 — OK]

% fallocate -l 100M backups/db-2026-10.sql.gz && fallocate -l 104M backups/db-2026-11.sql.gz && fallocate -l 3M uploads/photo.jpg
[exit 0 — OK]

$ df -h /lab
Filesystem      Size  Used Avail Use% Mounted on
overlay          59G   21G   36G  37% /
[exit 0 — OK]

# czas rozdziału: 1.8 s

## [03] Step 2: which folder? du -sh
$ du -sh *
93M	app
205M	backups
3.1M	uploads
[exit 0 — OK]

# czas rozdziału: 1.6 s

## [04] Step 3: drill down with --max-depth and sort -h
$ du -h --max-depth=2 . | sort -h
3.1M	./uploads
25M	./app/cache
69M	./app/logs
93M	./app
205M	./backups
300M	.
[exit 0 — OK]

$ du -ah . | sort -rh | head -6
300M	.
205M	./backups
104M	./backups/db-2026-11.sql.gz
100M	./backups/db-2026-10.sql.gz
93M	./app
69M	./app/logs
[exit 0 — OK]

# czas rozdziału: 1.5 s

## [05] Step 4: list the big files with find
$ find . -type f -size +50M -exec ls -lh {} +
-rw-r--r-- 1 root root  60M Nov 21 19:39 ./app/logs/app.log.1
-rw-r--r-- 1 root root 100M Nov 21 19:39 ./backups/db-2026-10.sql.gz
-rw-r--r-- 1 root root 104M Nov 21 19:39 ./backups/db-2026-11.sql.gz
[exit 0 — OK]

# czas rozdziału: 1.6 s

## [06] Step 5: free space safely
$ truncate -s 0 app/logs/app.log.1 && du -sh app
33M	app
[exit 0 — OK]

# czas rozdziału: 2.2 s

## [07] The mystery: df says full, du disagrees
$ fallocate -l 200M big.tmp && du -sh .
440M	.
[exit 0 — OK]

$ sleep 600 < big.tmp &
[exit 0 — OK]

$ rm big.tmp && du -sh .
240M	.
[exit 0 — OK]

$ find /proc/*/fd -lname '*(deleted)' -printf '%p -> %l\n' 2>/dev/null
/proc/120/fd/0 -> /lab/srv/big.tmp (deleted)
[exit 0 — OK]

$ kill %1
[exit 0 — OK]

# czas rozdziału: 1.5 s

## [08] Quick check
$ printf '100M\n9M\n1G\n' | sort
100M
1G
9M
[exit 0 — OK]

$ printf '100M\n9M\n1G\n' | sort -h
9M
100M
1G
[exit 0 — OK]

$ fallocate -l 10M quiz.tmp && { sleep 30 < quiz.tmp & p=$!; rm quiz.tmp; ls -l /proc/$p/fd/0 | sed 's/.*-> //'; kill $p; }
/lab/srv/quiz.tmp (deleted)
[exit 0 — OK]

# czas rozdziału: 1.6 s

