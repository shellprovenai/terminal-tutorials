# polecenia.log — systemd timers instead of cron: schedule a job, check the next run, read its logs
# obraz: localhost/shellproven-systemd-timers:13 (sha256:13284335e873c05e1350b0d15b633649524b96ef387e3aa30f8a6533d5dc5187), Debian 13.7, uruchomiono 2026-11-22T01:38:37Z
# wersje: systemd 257 (257.13-1~deb13u1)
# pakiety doinstalowane z repozytorium Debiana: systemd systemd-sysv dbus
# katalog roboczy: /root; każdy rozdział = osobna powłoka (bash --norc), jak w nagraniu
# '%' = przygotowanie (w filmie ukryte), '$' = polecenie pokazane w filmie

## [02] A job as a oneshot service
% printf '#!/bin/sh\necho "report generated at $(date +%%T)" >> /var/log/report.log\necho "report OK"\n' > /usr/local/bin/make-report && chmod +x /usr/local/bin/make-report
[exit 0 — OK]

% printf '[Unit]\nDescription=Generate the report\n\n[Service]\nType=oneshot\nExecStart=/usr/local/bin/make-report\n' > /etc/systemd/system/report.service
[exit 0 — OK]

% printf '[Unit]\nDescription=Run the report every 10 seconds (demo)\n\n[Timer]\nOnCalendar=*:*:0/10\nAccuracySec=1s\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n' > /etc/systemd/system/report.timer
[exit 0 — OK]

% systemctl daemon-reload
[exit 0 — OK]

$ systemctl cat report.service --no-pager
# /etc/systemd/system/report.service
[Unit]
Description=Generate the report

[Service]
Type=oneshot
ExecStart=/usr/local/bin/make-report
[exit 0 — OK]

$ systemctl start report.service && journalctl -u report.service --no-pager -n 4
Nov 22 01:38:38 demo systemd[1]: Starting report.service - Generate the report...
Nov 22 01:38:38 demo make-report[103]: report OK
Nov 22 01:38:38 demo systemd[1]: report.service: Deactivated successfully.
Nov 22 01:38:38 demo systemd[1]: Finished report.service - Generate the report.
[exit 0 — OK]

# czas rozdziału: 1.3 s

## [03] The timer
$ systemctl cat report.timer --no-pager
# /etc/systemd/system/report.timer
[Unit]
Description=Run the report every 10 seconds (demo)

[Timer]
OnCalendar=*:*:0/10
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
[exit 0 — OK]

$ systemctl enable --now report.timer
Created symlink '/etc/systemd/system/timers.target.wants/report.timer' → '/etc/systemd/system/report.timer'.
[exit 0 — OK]

# czas rozdziału: 1.8 s

## [04] When does it run next?
$ systemctl list-timers report.timer --no-pager
NEXT                        LEFT LAST PASSED UNIT         ACTIVATES
Sun 2026-11-22 01:38:50 UTC   8s -         - report.timer report.service

1 timers listed.
Pass --all to see loaded but inactive timers, too.
[exit 0 — OK]

# czas rozdziału: 1.3 s

## [05] Every run is in the journal
$ sleep 15; journalctl -u report.service --no-pager -n 6
Nov 22 01:38:38 demo systemd[1]: report.service: Deactivated successfully.
Nov 22 01:38:38 demo systemd[1]: Finished report.service - Generate the report.
Nov 22 01:38:50 demo systemd[1]: Starting report.service - Generate the report...
Nov 22 01:38:50 demo make-report[167]: report OK
Nov 22 01:38:50 demo systemd[1]: report.service: Deactivated successfully.
Nov 22 01:38:50 demo systemd[1]: Finished report.service - Generate the report.
[exit 0 — OK]

$ tail -n 3 /var/log/report.log
report generated at 01:38:38
report generated at 01:38:50
[exit 0 — OK]

# czas rozdziału: 16.1 s

