## [03] 1. Throw away an edit: git restore
$ echo "price = 0" >> app.conf
[exit 0 — OK]

$ git status --short
 M app.conf
[exit 0 — OK]

$ git restore app.conf
[exit 0 — OK]

$ cat app.conf
price = 10
currency = EUR
debug = true
[exit 0 — OK]

# czas rozdziału: 2.4 s

## [04] 2. Unstage a file: git restore --staged
$ echo "tax = 23" >> app.conf && git add app.conf && git status --short
M  app.conf
[exit 0 — OK]

$ git restore --staged app.conf && git status --short
 M app.conf
[exit 0 — OK]

$ git restore app.conf
[exit 0 — OK]

# czas rozdziału: 1.6 s

## [05] 3. Undo the last commit, keep the changes: reset --soft
$ git reset --soft HEAD~1
[exit 0 — OK]

$ git status --short && git log --oneline
M  app.conf
fd5812a Add currency
1e485e5 Add config
[exit 0 — OK]

$ git commit -qm "Enable debug (only in dev)" && git log --oneline
c7dd427 Enable debug (only in dev)
fd5812a Add currency
1e485e5 Add config
[exit 0 — OK]

# czas rozdziału: 1.6 s

## [06] 4. Drop a commit with reset --hard, then get it back
$ git reset --hard HEAD~1
HEAD is now at fd5812a Add currency
[exit 0 — OK]

$ cat app.conf
price = 10
currency = EUR
[exit 0 — OK]

$ git reflog | head -3
fd5812a HEAD@{0}: reset: moving to HEAD~1
c7dd427 HEAD@{1}: commit: Enable debug (only in dev)
fd5812a HEAD@{2}: reset: moving to HEAD~1
[exit 0 — OK]

$ git reset --hard "HEAD@{1}" && git log --oneline
HEAD is now at c7dd427 Enable debug (only in dev)
c7dd427 Enable debug (only in dev)
fd5812a Add currency
1e485e5 Add config
[exit 0 — OK]

# czas rozdziału: 1.9 s

## [07] 5. Undo a shared commit: git revert
$ git revert --no-edit HEAD
[main f9720ea] Revert "Enable debug (only in dev)"
 Date: Sat Nov 21 15:37:12 2026 +0000
 1 file changed, 1 deletion(-)
[exit 0 — OK]

$ git log --oneline && cat app.conf
